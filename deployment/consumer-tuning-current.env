# Current consumer settings validated: 4 ingests, full1M, warmup300/s then main600/s, 2026-11-10. See performance results.
CONSUMER_THREADS=40
CONSUMER_PREFETCH=50
DB_BATCH_SIZE=50
DB_BATCH_WAIT_MS=5
ACK_BATCH_SIZE=25
ACK_FLUSH_MS=5
SQLITE_CACHE_KIB=262144
SQLITE_CHECKPOINT_PAGES=65536
SQLITE_CHECKPOINT_MS=1000
